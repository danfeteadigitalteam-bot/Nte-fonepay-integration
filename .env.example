# --- Fonepay (required) ---
FONEPAY_BASE_URL=https://thirdparty-merchantapi.fonepay.com
FONEPAY_USERNAME=
FONEPAY_PASSWORD=
FONEPAY_TERMINAL_ID=
FONEPAY_PRIVATE_KEY_B64=

# --- Server (required for production) ---
NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://nte-fonepay-integration.onrender.com
CHECKOUT_HMAC_SECRET=

# Comma-separated hosts allowed for redirect_url (no https:// prefix)
ALLOWED_REDIRECT_HOSTS=nepal-tea-exchange.myshopify.com

# Optional: if Fonepay signs webhooks
FONEPAY_WEBHOOK_SECRET=

# --- Shopify Admin API (optional — leave empty for manual mark-paid in Admin) ---
SHOPIFY_STORE_DOMAIN=nepal-tea-exchange.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2024-10
